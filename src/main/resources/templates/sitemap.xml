<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <!-- High Priority - Core Pages -->
    <url>
        <loc>https://zoukme.in/</loc>
        <lastmod>2026-08-10</lastmod>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
    </url>
    <url>
        <loc>https://zoukme.in/events</loc>
        <lastmod>2026-08-10</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.9</priority>
    </url>
    <url>
        <loc>https://zoukme.in/prices</loc>
        <lastmod>2026-08-10</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
    </url>

    <!-- Medium Priority - Info Pages -->
    <url>
        <loc>https://zoukme.in/learnmore</loc>
        <lastmod>2026-08-10</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
    </url>
    <url>
        <loc>https://zoukme.in/about</loc>
        <lastmod>2026-08-10</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
    </url>

    <!-- Dynamic Event URLs -->
    <url th:each="event : ${events}">
        <loc th:text="'https://zoukme.in/events/' + ${event.eventUrl}"/>
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
    </url>
</urlset>
